		"mediabunny": "^1.65.0",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
